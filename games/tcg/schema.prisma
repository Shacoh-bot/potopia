// Domaine tcg : jeu de cartes, en préparation. Seul le vote des designs est ouvert aux membres ;
// les cartes, les boosters et le Potodex ne servent qu'aux admins pour l'instant (test).
// `userId` référence core.users sans relation.

// Note d'un membre sur une proposition de design de carte (une par membre et par design).
model TcgDesignVote {
  id        String   @id @default(uuid(7))
  designId  String   @map("design_id")
  userId    String   @map("user_id")
  stars     Int
  comment   String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([designId, userId])
  @@map("design_votes")
  @@schema("tcg")
}

// Rareté d'une carte : fixe, portée par la carte (modifiable seulement par un admin).
enum TcgRarity {
  common
  uncommon
  rare
  epic
  legendary
  sr
  ssr

  @@schema("tcg")
}

// Mise en page d'une carte : illustration dans une fenêtre (normale) ou sur toute la carte.
enum TcgCardLayout {
  normal
  fullart

  @@schema("tcg")
}

// Une édition de cartes.
model TcgSet {
  id        String   @id @default(uuid(7))
  code      String   @unique
  name      String
  createdAt DateTime @default(now()) @map("created_at")

  cards    TcgCard[]
  openings TcgBoosterOpening[]
  pending  TcgPendingBooster[]

  @@map("sets")
  @@schema("tcg")
}

// Une carte. Dans un set, elle a un numéro et ira en prod avec lui ; sans set, elle attend dans la
// réserve. L'effet est une clé du catalogue codé (`src/effects.ts`) et ses réglages ; la base ne
// contient aucune logique. `ideaId` référence ideas.ideas sans relation : un simple lien de gestion
// (une idée peut donner plusieurs cartes), sans effet en jeu. Une variante full art pointe vers sa
// carte de base et en reprend toujours les stats.
model TcgCard {
  id                String        @id @default(uuid(7))
  setId             String?       @map("set_id")
  number            Int?
  name              String
  rarity            TcgRarity
  type              String
  family            String?
  cost              Int
  power             Int
  // Cochée : coût et puissance saisis à la main. Sinon, une carte avec effet prend ceux de la
  // carte Snap de l'effet (`effectStats`), appliqués à chaque enregistrement.
  statsManual       Boolean       @default(false) @map("stats_manual")
  effectKey         String?       @map("effect_key")
  effectParams      Json?         @map("effect_params")
  effectText        String        @default("") @map("effect_text")
  flavor            String?
  // Note de l'admin (« Doublon de … ») : jamais montrée aux joueurs, sans effet en jeu.
  adminNote         String?       @map("admin_note")
  // Étape de préparation dans la réserve (`CARD_PREP_STAGES`) : illustration, effet, intégration.
  // Repère d'admin seulement, sans effet en jeu.
  prepStage         String        @default("todo") @map("prep_stage")
  // Clé de l'illustration dans le stockage (jamais une URL) ; sans elle, l'image de l'idée.
  imageKey          String?       @map("image_key")
  // Illustration propre à la version full art ; null : la full art reprend `imageKey`.
  imageKeyFull      String?       @map("image_key_full")
  // Version réduite de chaque illustration (côté long `CARD_IMAGE_SIZES.small`), pour les petites
  // cartes (planches, Potodex, booster) ; la grande ne se charge qu'agrandie. null : pas de version
  // réduite (illustrations envoyées avant), la carte montre l'illustration elle-même, comme avant.
  imageKeySmall     String?       @map("image_key_small")
  imageKeyFullSmall String?       @map("image_key_full_small")
  // Son propre joué quand la carte se retourne dans un booster (MP3 dans le stockage, jamais une
  // URL) : il remplace les bruitages du retournement. null : bruitages de sa rareté.
  revealSoundKey     String?      @map("reveal_sound_key")
  // Son propre de la version full art ; null : celui de la normale (`revealSoundKey`).
  revealSoundKeyFull String?      @map("reveal_sound_key_full")
  // Cadrage de l'illustration (point central en % et zoom) : l'image n'est jamais rognée.
  imageFrame        Json?         @map("image_frame")
  // Cadrage de l'illustration en full art ; null : celui de la carte normale (imageFrame).
  imageFrameFull    Json?         @map("image_frame_full")
  // Points lumineux posés sur l'illustration (JSON : position en % de l'image, taille, couleur,
  // vitesse de clignotement) ; null : aucun.
  glowPoints        Json?         @map("glow_points")
  // Points lumineux de la full art, réglés à part de ceux de la normale ; null : aucun.
  glowPointsFull    Json?         @map("glow_points_full")
  // Mise en page choisie pour afficher la carte (normale ou full art).
  layout            TcgCardLayout @default(normal)
  // Versions qui existent pour la carte (au moins une) : chacune se tire et se collectionne à part.
  // `layout` est la version montrée par défaut (planches de l'admin), toujours une version active.
  hasNormal         Boolean       @default(true) @map("has_normal")
  hasFullArt        Boolean       @default(false) @map("has_full_art")
  ideaId            String?       @map("idea_id")
  baseCardId        String?       @map("base_card_id")
  // Carte dont celle-ci est le doublon, choisie dans la liste au passage au « Doublon » ; null :
  // aucune (carte hors « Doublon », ou doublon marqué avant ce choix, à relier).
  duplicateOfId     String?       @map("duplicate_of_id")
  // Mise à la corbeille : hors set et hors des listes ; null, carte active.
  deletedAt         DateTime?     @map("deleted_at")
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  set           TcgSet?               @relation(fields: [setId], references: [id])
  base          TcgCard?              @relation("TcgCardVariant", fields: [baseCardId], references: [id])
  // Effets visuels de la carte, dans l'ordre des calques.
  visualEffects TcgCardVisualEffect[]
  variants      TcgCard[]             @relation("TcgCardVariant")
  duplicateOf   TcgCard?              @relation("TcgCardDuplicate", fields: [duplicateOfId], references: [id], onDelete: SetNull)
  duplicates    TcgCard[]             @relation("TcgCardDuplicate")
  owners        TcgOwnedCard[]

  @@unique([setId, number])
  @@index([ideaId])
  @@map("cards")
  @@schema("tcg")
}

// Catalogue des effets visuels qu'on peut poser sur une carte (choisis dans la fiche). La base ne
// garde que la clé et le nom affiché ; le rendu (CSS/JS) est codé dans `ui/visual-effects.tsx`,
// sous la même clé. Nouvel effet : une migration qui ajoute la ligne, plus son rendu dans le code.
model TcgVisualEffect {
  key       String   @id
  name      String
  createdAt DateTime @default(now()) @map("created_at")

  cards TcgCardVisualEffect[]

  @@map("visual_effects")
  @@schema("tcg")
}

// Effet visuel posé sur une version de carte (normale ou full art, réglées à part). Une version en
// a plusieurs : `position` donne l'ordre des calques (0 en dessous). Retirer un effet du catalogue
// le retire des cartes.
model TcgCardVisualEffect {
  cardId    String        @map("card_id")
  version   TcgCardLayout @default(normal)
  effectKey String        @map("effect_key")
  position  Int

  card   TcgCard         @relation(fields: [cardId], references: [id], onDelete: Cascade)
  effect TcgVisualEffect @relation(fields: [effectKey], references: [key], onDelete: Cascade)

  @@id([cardId, version, effectKey])
  @@index([effectKey])
  @@map("card_visual_effects")
  @@schema("tcg")
}

// Carte trouvée par un membre (Potodex) : une ligne par carte, `count` exemplaires tirés.
// Supprimer la carte la retire des collections.
model TcgOwnedCard {
  userId    String        @map("user_id")
  cardId    String        @map("card_id")
  // Version possédée : la normale et la full art d'une carte se collectionnent séparément.
  version   TcgCardLayout @default(normal)
  count     Int
  firstAt   DateTime      @default(now()) @map("first_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  card TcgCard @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@id([userId, cardId, version])
  @@index([cardId])
  @@map("owned_cards")
  @@schema("tcg")
}

// Paquet ouvert : les 5 cartes tirées, dans l'ordre. `hasSsr` sert à la garantie de SSR (au plus
// tard au 30e paquet d'un set). `cardIds` sont des ids de cartes de ce domaine, sans relation.
model TcgBoosterOpening {
  id        String   @id @default(uuid(7))
  userId    String   @map("user_id")
  setId     String   @map("set_id")
  cardIds   String[] @map("card_ids")
  hasSsr    Boolean  @map("has_ssr")
  // Le paquet avait une SR ou une SSR : remet à zéro la garantie « SR ou mieux ».
  hasSrPlus Boolean  @default(false) @map("has_sr_plus")
  // Paquet de test de l'admin (une carte de chaque rareté haute) : hors garanties et hors taux.
  isTest    Boolean  @default(false) @map("is_test")
  createdAt DateTime @default(now()) @map("created_at")

  set TcgSet @relation(fields: [setId], references: [id], onDelete: Cascade)

  @@index([userId, setId, createdAt])
  @@map("booster_openings")
  @@schema("tcg")
}

// Prochain paquet d'un joueur, déjà tiré (même tirage, mêmes chances, garanties comprises) : ses
// illustrations se préchargent avant le clic, et l'ouverture le consomme puis tire le suivant. Un
// par joueur, par set et par type de paquet (test de l'admin ou normal).
model TcgPendingBooster {
  id        String   @id @default(uuid(7))
  userId    String   @map("user_id")
  setId     String   @map("set_id")
  isTest    Boolean  @map("is_test")
  // Les cartes dans l'ordre du paquet : [{ id, rarity, version }].
  cards     Json
  // Empreinte du tirage (cartes tirables du set et garantie appliquée) : si elle change, le
  // paquet est tiré à nouveau (voir `poolKey`).
  poolKey   String   @map("pool_key")
  createdAt DateTime @default(now()) @map("created_at")

  set TcgSet @relation(fields: [setId], references: [id], onDelete: Cascade)

  @@unique([userId, setId, isTest])
  @@map("pending_boosters")
  @@schema("tcg")
}
